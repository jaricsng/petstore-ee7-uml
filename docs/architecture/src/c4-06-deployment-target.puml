@startuml c4-06-deployment-target
' C4 model - Deployment diagram (target, production-grade)
!include <C4/C4_Deployment>
title C4 Deployment - Target (recommended): containerised, highly available, zero-trust network zones

Deployment_Node(inet, "Internet") {
  Deployment_Node(dev, "User device", "Browser") {
    Container(ui, "Browser UI", "HTML5, CSP-restricted")
  }
}

Deployment_Node(cloud, "Cloud region (2+ availability zones)", "Kubernetes 1.30+ or managed container platform") {
  Deployment_Node(dmz, "Public zone", "Ingress controller") {
    Container(edge, "Reverse Proxy + WAF", "NGINX Ingress + ModSecurity OWASP CRS", "TLS 1.3, HSTS, security headers, rate limits")
  }
  Deployment_Node(app, "Application zone", "Namespace petstore, NetworkPolicies, Pod Security 'restricted'") {
    Deployment_Node(pod, "petstore pods x3", "Distroless JRE 21 image, non-root, read-only FS; HPA 3..10") {
      Container(web, "Web Application + REST API v1", "Jakarta EE 10 runtime")
    }
    ContainerDb(cache, "Infinispan / Redis", "3-node cluster", "sessions, L2 cache")
  }
  Deployment_Node(data, "Data zone", "Private subnets only") {
    ContainerDb(db, "PostgreSQL 16 (managed)", "Primary + standby, PITR backups, encryption at rest")
  }
  Deployment_Node(ops, "Operations zone") {
    Container(otel, "OpenTelemetry Collector + Prometheus/Grafana/Loki", "SLOs, alerting")
    Container(secrets, "Secrets Manager / Vault", "DB credentials, OIDC client secret; rotated")
  }
}

Rel(ui, edge, "HTTPS 443")
Rel(edge, web, "HTTP 8080 (mTLS in mesh optional)")
Rel(web, cache, "Hot Rod / RESP")
Rel(web, db, "JDBC over TLS 5432")
Rel(web, otel, "OTLP 4317")
Rel(web, secrets, "Reads secrets at start-up")
SHOW_LEGEND()
@enduml
