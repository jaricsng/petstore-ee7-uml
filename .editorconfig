root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = false
max_line_length = 160
tab_width = 4
trim_trailing_whitespace = false

[{*.xml,*.xsd,*.xsl,*.xslt}]
indent_size = 2
tab_width = 2

# Added in this repository: repository tooling, CI and documentation (upstream Java/XML settings above unchanged)
[{*.yml,*.yaml,*.json,*.puml,*.iuml,*.py,*.sh}]
insert_final_newline = true
trim_trailing_whitespace = true

[{*.yml,*.yaml,*.json,*.puml,*.iuml}]
indent_size = 2
tab_width = 2
